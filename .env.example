# DISCORD_TOKEN: Required for Daki bot to run.
# Gets the actual token from developer portal.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
WELCOME_CHANNEL_ID=
ENABLE_MESSAGE_CONTENT_INTENT=true
ENABLE_GUILD_MEMBERS_INTENT=true

# GEMINI_API_KEY: Google AI Studio API key
GEMINI_API_KEY=

# GEMINI_MODEL: Model to use for AI responses. Defaults to gemini-1.5-flash-8b if not specified.
# Recommended options for free tier:
# - gemini-1.5-flash-8b (Lightest, fastest, recommended for high-frequency chat)
# - gemini-1.5-flash (Balanced speed, reasoning and cost)
# - gemini-2.5-flash (More advanced, but has stricter rate limits depending on your usage tier)
GEMINI_MODEL=gemini-1.5-flash-8b

