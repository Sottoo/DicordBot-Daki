# DISCORD_TOKEN: Required for Daki bot to run.
# Gets the actual token from developer portal.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
WELCOME_CHANNEL_ID=

# ⚠️ CRÍTICO PARA LA MODERACIÓN ⚠️
# El bot NO PUEDE ver el texto de los mensajes sin el "Message Content Intent".
# Sin él, el anti-enlaces y el anti-raid quedan completamente ciegos.
# Debes activarlo EN DOS SITIOS:
#   1) https://discord.com/developers/applications → tu app → Bot →
#      activa "MESSAGE CONTENT INTENT" y "SERVER MEMBERS INTENT"
#   2) Aquí abajo (ya viene activado por defecto; solo 'false' lo desactiva)
# Comprueba que esté bien con el comando /diagnostico dentro de Discord.
ENABLE_MESSAGE_CONTENT_INTENT=true
ENABLE_GUILD_MEMBERS_INTENT=true

# --- Guardián: sistema anti-raid y anti-enlaces ---
# Todo esto se puede configurar en caliente con /guardian; estas variables solo
# fijan los valores iniciales al arrancar.
# GUARDIAN_ACTIVO: 'false' apaga todo el sistema de defensa.
GUARDIAN_ACTIVO=true
# GUARDIAN_LOG_CHANNEL_ID: canal donde se registra TODO lo que hace el guardián.
GUARDIAN_LOG_CHANNEL_ID=
# GUARDIAN_ALERT_CHANNEL_ID: canal para incidentes graves (si está vacío usa el de logs).
GUARDIAN_ALERT_CHANNEL_ID=
# GUARDIAN_ALERT_ROLE_ID: rol de moderación al que mencionar en incidentes graves.
GUARDIAN_ALERT_ROLE_ID=
# GUARDIAN_SANCION_MAXIMA: hasta dónde puede llegar el bot solo → timeout | kick | ban
GUARDIAN_SANCION_MAXIMA=timeout
# GUARDIAN_AUTO_LOCKDOWN: 'true' cierra todos los canales automáticamente si detecta un raid.
GUARDIAN_AUTO_LOCKDOWN=false

# GEMINI_API_KEY: Google AI Studio API key
GEMINI_API_KEY=

# GEMINI_MODEL: Model to use for AI responses. Defaults to gemini-3.1-flash-lite if not specified.
# Recommended options for free tier:
# - gemini-3.1-flash-lite (Lighter, faster, 15 RPM / 500 RPD, recommended for high-frequency chat)
# - gemini-2.5-flash-lite (10 RPM / 20 RPD)
# - gemini-2.5-flash (5 RPM / 20 RPD)
GEMINI_MODEL=gemini-3.1-flash-lite

# GEMINI_THINKING_LEVEL: Controls the reasoning level (thinking time) for Gemini 3.x models.
# Options: 'minimal', 'low', 'medium', 'high'.
# Set to 'minimal' to disable thinking latency (instant responses, ideal for active Discord chat).
GEMINI_THINKING_LEVEL=minimal

# --- Avisos de directo en TikTok ---
# TIKTOK_USERNAME: usuario de TikTok a vigilar (con o sin @). Por defecto: daki0542
TIKTOK_USERNAME=daki0542
# TIKTOK_ANNOUNCE_CHANNEL_ID: ID del canal de Discord donde se envían los avisos.
TIKTOK_ANNOUNCE_CHANNEL_ID=1505781686271737956
# TIKTOK_MENTION: a quién mencionar en el aviso. '@everyone', un rol '<@&ID>' o vacío para no mencionar.
TIKTOK_MENTION=@everyone
# TIKTOK_POLL_INTERVAL_MS: cada cuánto comprobar si está en directo (mínimo 60000). Por defecto: 180000 (3 min)
TIKTOK_POLL_INTERVAL_MS=180000
# TIKTOK_ENABLED: pon 'false' para desactivar los avisos de directo.
TIKTOK_ENABLED=true


# --- Almacenamiento de datos ---
# DATA_DIR: carpeta donde se guardan el XP (xp.json) y la config del guardián
# (guardian.json). Obligatoria en un servidor propio (AWS EC2, VPS...), porque
# la ruta /app/data solo existe en Railway.
#   AWS/EC2:  DATA_DIR=/home/ubuntu/daki-bot/data
#   Railway:  déjala vacía (usa el volumen /app/data)
#   Local:    déjala vacía (usa ./data)
DATA_DIR=
